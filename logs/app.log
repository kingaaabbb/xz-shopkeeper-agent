SELECT 
    dc.member_level AS 会员等级,
    COUNT(fo.order_quantity) AS 订单数,
    SUM(fo.order_amount) AS 销售额
FROM 
    fact_order fo
INNER JOIN 
    dim_customer dc ON fo.customer_id = dc.customer_id
INNER JOIN 
    dim_date dd ON fo.date_id = dd.date_id
WHERE 
    quarter = 'Q1' AND 
    (CONCAT('0', dd.date_id) >= '2025-01-01' AND CONCAT('0', dd.date_id) <= '2025-03-31')
GROUP BY 
    dc.member_level;
